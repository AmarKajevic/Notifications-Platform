# Postgres connection string (Supabase, RDS, local — anything Prisma's pg adapter can reach)
DATABASE_URL="postgresql://user:password@host:5432/database"

# Comma-separated Kafka broker list (for services running on your host machine;
# docker-compose.prod.yml overrides this for containers)
KAFKA_BROKERS="localhost:9092"

# Redis (idempotency keys + rate limiting) — gateway only
REDIS_URL="redis://localhost:6379"

# SMTP server for email-worker (defaults match the Mailpit container)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="notifications@local.test"
